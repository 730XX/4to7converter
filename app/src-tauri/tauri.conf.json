{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "osu-4to7-converter",
  "version": "0.1.0",
  "identifier": "com.osu4to7.converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "4to7 Mania",
        "width": 1280,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "visible": false,
        "center": true
      },
      {
        "label": "splashscreen",
        "width": 450,
        "height": 400,
        "url": "splashscreen.html",
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b0e14"
      }
    ],
"security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
